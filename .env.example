# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Supabase PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:Hello10122%40ususbhaj@db.zwlovcpkmydzcuoexjbg.supabase.co:5432/postgres"

# PAYSTACK INTEGRATION KEYS
# VITE_PAYSTACK_PUBLIC_KEY: Your Paystack API Public Key for client-side Inline Checkout (starts with pk_live_ or pk_test_)
VITE_PAYSTACK_PUBLIC_KEY="pk_test_95bf08d249f0ecba8ce6b09320b9eef833075249"

# PAYSTACK_SECRET_KEY: Your Paystack API Secret Key for server-side webhook verification & transfers (starts with sk_live_ or sk_test_)
PAYSTACK_SECRET_KEY="sk_test_xxxxxx"

# FLUTTERWAVE INTEGRATION KEYS
# VITE_FLUTTERWAVE_PUBLIC_KEY: Your Flutterwave API Public Key (starts with FLWPUBK_TEST- or FLWPUBK-)
VITE_FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-SANDBOX"

# FLUTTERWAVE_SECRET_KEY: Your Flutterwave API Secret Key for transfers/payouts (starts with FLWSECK_TEST- or FLWSECK-)
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxx"

# FLUTTERWAVE_SECRET_HASH: Secret hash for Flutterwave webhook verification (verif-hash header)
FLUTTERWAVE_SECRET_HASH="flw_sec_b8e217d4a940f5c1e309"

